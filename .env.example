# Copy this file to .env if you want to run this on your own computer.
# If you're deploying with the "Deploy to Render" button in the README,
# you can ignore this file entirely — none of this is required.

PORT=3000

# A long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you skip this, a default is used, which is fine for trying it out
# locally but not for a real deployment.
SESSION_SECRET=change-me-to-something-random

# Optional starting names — you can also set/change these later from the
# app's Settings tab, no restart needed.
PATIENT_NAME=Sweetheart
CAREGIVER_NAME=You

# Push notifications work with zero setup: the server generates its own
# notification keys the first time it starts and reuses them after that.
# You only need these if you want to pin specific keys yourself.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=mailto:you@example.com

# Database. Leave both blank to use a local file (data.db) — fine for
# running on your own computer. For a real always-on deployment, set these
# to a free Turso database so data survives restarts (see the README).
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Set to "true" to also send an automatic reminder push at each
# medication's scheduled time, if it hasn't been marked taken yet.
ENABLE_AUTO_REMINDERS=false

NODE_ENV=development
