# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

PORT=3000

# PINs for the two people using the app. Keep these private — anyone with
# the PIN and a link to the app can log in as that person.
PATIENT_PIN=1234
CAREGIVER_PIN=5678

# Display names shown in the UI and notifications.
PATIENT_NAME=Alex
CAREGIVER_NAME=You

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-something-random

# Push notifications (Web Push / VAPID). Generate with:
#   npm run generate-vapid-keys
# and paste the output below. Without these, the app still works but
# reminder/confirmation push notifications are disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com

# Set to "true" to also send an automatic reminder push at each
# medication's scheduled time, if it hasn't been marked taken yet.
ENABLE_AUTO_REMINDERS=false

NODE_ENV=development
